        <inertial><mass>0.06</mass><inertia>
          <ixx>0.000014</ixx><iyy>0.000014</iyy><izz>0.000012</izz>
        </inertia></inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.02</radius><length>0.04</length></cylinder></geometry>
